<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="userRepository" class="com.github.enerccio.lingollm.domain.security.repository.impl.JpaUserRepository">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean class="com.github.enerccio.lingollm.domain.security.AdminGuard" />

    <bean class="com.github.enerccio.lingollm.domain.security.service.impl.UserServiceImpl">
        <property name="repository" ref="userRepository" />
    </bean>

    <bean class="com.github.enerccio.lingollm.domain.service.impl.InferenceServicesImpl">
        <property name="inferenceProviders">
            <list>
                <value>com.github.enerccio.lingollm.domain.service.impl.inference.OpenAICompatibleInferenceService</value>
            </list>
        </property>
    </bean>

    <bean id="settingRepository" class="com.github.enerccio.lingollm.domain.repository.impl.JpaSettingRepository">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean class="com.github.enerccio.lingollm.domain.service.impl.SettingServiceImpl">
        <property name="repository" ref="settingRepository" />
    </bean>

    <bean id="resourceRepository" class="com.github.enerccio.lingollm.domain.repository.impl.JpaResourceRepository">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean class="com.github.enerccio.lingollm.domain.service.impl.ResourceServiceImpl">
        <property name="repository" ref="resourceRepository" />
    </bean>

    <bean id="aiRepository" class="com.github.enerccio.lingollm.domain.repository.impl.JpaAIRepository">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean class="com.github.enerccio.lingollm.domain.service.impl.AIServiceImpl">
        <property name="repository" ref="aiRepository" />
    </bean>

    <bean id="usageRepository" class="com.github.enerccio.lingollm.domain.repository.impl.JpaUsageRepository">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean class="com.github.enerccio.lingollm.domain.service.impl.UsageServiceImpl">
        <property name="repository" ref="usageRepository" />
    </bean>

    <bean class="com.github.enerccio.lingollm.domain.service.impl.AILimitServiceImpl" />

    <bean id="languageRepository" class="com.github.enerccio.lingollm.domain.repository.impl.JpaLanguageRepository">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean class="com.github.enerccio.lingollm.domain.service.impl.LanguageServiceImpl">
        <property name="repository" ref="languageRepository" />
    </bean>

    <bean id="freeChatRepository" class="com.github.enerccio.lingollm.domain.repository.impl.JpaFreeChatRepository">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean class="com.github.enerccio.lingollm.domain.service.impl.FreeChatServiceImpl">
        <property name="repository" ref="freeChatRepository" />
    </bean>

    <bean id="freeChatMessageRepository" class="com.github.enerccio.lingollm.domain.repository.impl.JpaFreeChatMessageRepository">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean class="com.github.enerccio.lingollm.domain.service.impl.FreeChatMessageServiceImpl">
        <property name="repository" ref="freeChatMessageRepository" />
    </bean>

    <bean id="testRepository" class="com.github.enerccio.lingollm.domain.repository.impl.JpaTestRepository">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean class="com.github.enerccio.lingollm.domain.service.impl.TestServiceImpl">
        <property name="repository" ref="testRepository" />
    </bean>

    <bean id="testQuestionGroupRepository" class="com.github.enerccio.lingollm.domain.repository.impl.JpaTestQuestionGroupRepository">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean class="com.github.enerccio.lingollm.domain.service.impl.TestQuestionGroupServiceImpl">
        <property name="repository" ref="testQuestionGroupRepository" />
    </bean>

    <bean id="testQuestionRepository" class="com.github.enerccio.lingollm.domain.repository.impl.JpaTestQuestionRepository">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean class="com.github.enerccio.lingollm.domain.service.impl.TestQuestionServiceImpl">
        <property name="repository" ref="testQuestionRepository" />
    </bean>

    <bean id="testResultRepository" class="com.github.enerccio.lingollm.domain.repository.impl.JpaTestResultRepository">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean class="com.github.enerccio.lingollm.domain.service.impl.TestResultServiceImpl">
        <property name="repository" ref="testResultRepository" />
    </bean>

    <bean id="testQuestionResultRepository" class="com.github.enerccio.lingollm.domain.repository.impl.JpaTestQuestionResultRepository">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean class="com.github.enerccio.lingollm.domain.service.impl.TestQuestionResultServiceImpl">
        <property name="repository" ref="testQuestionResultRepository" />
    </bean>

    <bean class="com.github.enerccio.lingollm.domain.service.impl.TestQuestionFactoryRegistryImpl" />

    <bean class="com.github.enerccio.lingollm.domain.service.impl.TestQuestionGroupFactoryRegistryImpl" />

    <bean id="japaneseLanguageDefinitionService" class="com.github.enerccio.lingollm.domain.service.impl.languages.JapaneseLanguageDefinitionServiceImpl" />

    <bean id="germanLanguageDefinitionService" class="com.github.enerccio.lingollm.domain.service.impl.languages.GermanLanguageDefinitionServiceImpl" />

    <bean class="com.github.enerccio.lingollm.domain.service.impl.TemplateServiceImpl" />

    <bean class="com.github.enerccio.lingollm.domain.service.impl.DatabaseBackupServiceImpl" />

    <bean class="com.github.enerccio.lingollm.domain.service.impl.OsgiServiceImpl" />

    <bean class="com.github.enerccio.lingollm.domain.service.impl.ExtensionServiceImpl" />

    <bean class="com.github.enerccio.lingollm.domain.service.impl.CleanupServiceImpl">
        <property name="entityManager" ref="em" />
    </bean>

    <bean class="com.github.enerccio.lingollm.instruct.RuntimeInstrumentationInitializer" />
</beans>